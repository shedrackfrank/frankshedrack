---
import { Image } from "astro:assets";
import BaseLayout from "./BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import SocialRail from "../components/layout/SocialRail.astro";
import MobileDock from "../components/layout/MobileDock.astro";
import Footer from "../components/layout/Footer.astro";
import CaseStudyMeta from "../components/project/CaseStudyMeta.astro";
import { name } from "../data/site";
import type { Project } from "../lib/projects";

interface Props { entry: Project; next?: Project }
const { entry, next } = Astro.props;
const { data, id } = entry;
const categoryLabel = data.category === "security" ? "Security assessment" : "Web project";
const featuredImage = data.featuredImage;
const featuredImageAlt = data.featuredImageAlt && data.featuredImageAlt.trim() !== "" ? data.featuredImageAlt : `Featured image for ${data.title}`;
---

<BaseLayout title={`${data.title} — ${name}`} description={data.shortDescription} type="article">
  <Header />
  <SocialRail />
  <main id="main">
    <article class="case-study wrap">
      <a class="back mono text-link" href="/#work">← Back to work</a>
      <p class="category mono">{categoryLabel}</p>
      <h1 transition:name={`project-title-${id}`}>{data.title}</h1>
      <p class="lead">{data.shortDescription}</p>
      <CaseStudyMeta entry={entry} />
      <figure class:list={["feature-frame", { "feature-frame--empty": !featuredImage }]} transition:name={`project-image-${id}`}>
        {featuredImage ? (
          <Image src={featuredImage} alt={featuredImageAlt} width={featuredImage.width} height={featuredImage.height} loading="eager" fetchpriority="high" decoding="async" />
        ) : (
          <div class="feature-placeholder"><div class="feature-grid" aria-hidden="true"></div><span class="mono">Image pending</span></div>
        )}
      </figure>
      <div class="case-body"><slot /></div>
    </article>
    {next && <section class="next-project wrap" aria-labelledby="next-project-heading">
      <p id="next-project-heading" class="next-label mono">Next project</p>
      <a class="next-link" href={`/work/${next.id}`}>
        <span><span class="next-category mono">{next.data.category === "security" ? "Security assessment" : "Web project"}</span><span class="next-title">{next.data.title}</span></span>
        <span class="next-arrow" aria-hidden="true">→</span>
      </a>
    </section>}
  </main>
  <Footer />
  <MobileDock />
</BaseLayout>

<style>
  .case-study { padding-top: 40px; padding-bottom: clamp(64px, 8vw, 96px); }
  .back { display: inline-flex; min-height: 44px; align-items: center; color: var(--token-muted); font-size: 13px; text-decoration: none; transition: color var(--duration-fast) var(--easing-standard); }
  .back:hover { color: var(--token-accent); }
  .category { margin: 48px 0 16px; color: var(--token-accent); font-size: 13px; letter-spacing: 0.14em; text-transform: uppercase; }
  h1 { max-width: 100%; margin: 0; color: var(--token-fg); font-size: clamp(48px, 9vw, 132px); font-weight: 600; letter-spacing: -0.035em; line-height: 0.94; overflow-wrap: anywhere; }
  .lead { max-width: 760px; margin: 28px 0 0; color: var(--token-muted); font-size: clamp(21px, 2.5vw, 32px); line-height: 1.3; }
  .feature-frame { position: relative; display: grid; place-items: center; margin: 48px 0 0; overflow: hidden; border: 1px solid var(--token-line); border-radius: var(--radius-media); background: var(--token-surface); padding: clamp(16px, 4vw, 40px); }
  .feature-frame :global(img) { display: block; width: auto; max-width: 100%; height: auto; object-fit: contain; }
  .feature-frame--empty { aspect-ratio: 16 / 9; padding: 0; }
  .feature-placeholder { position: absolute; inset: 0; display: grid; place-items: center; color: var(--token-muted); }
  .feature-grid { position: absolute; inset: 0; background-image: linear-gradient(var(--token-grid) 1px, transparent 1px), linear-gradient(90deg, var(--token-grid) 1px, transparent 1px); background-size: 32px 32px; }
  .feature-placeholder span { position: relative; font-size: 12px; }
  .case-body { max-width: 900px; margin: 0 auto; }
  .case-body :global(.case-section) { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 9fr); gap: 48px; padding-top: 64px; border-top: 1px solid var(--token-line); }
  .case-body :global(.case-section + .case-section) { margin-top: 64px; }
  .case-body :global(.eyebrow) { margin: 8px 0 0; color: var(--token-accent); font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; }
  .case-body :global(h2) { margin: 0; color: var(--token-fg); font-size: clamp(28px, 3.2vw, 44px); font-weight: 500; letter-spacing: -0.025em; line-height: 1.05; }
  .case-body :global(.section-content) { min-width: 0; overflow-wrap: anywhere; color: var(--token-muted); font-size: 18px; line-height: 1.7; }
  .case-body :global(.section-content p) { margin: 0; }
  .case-body :global(.definition-list) { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; margin: 0; }
  .case-body :global(.definition-list dt) { color: var(--token-muted); font-family: var(--font-mono); font-size: 12px; text-transform: uppercase; }
  .case-body :global(.definition-list dd) { margin: 8px 0 0; color: var(--token-fg); }
  .case-body :global(.recommendations) { margin: 0; padding-left: 2.5em; counter-reset: recommendations; list-style: none; }
  .case-body :global(.recommendations li) { position: relative; margin-top: 12px; counter-increment: recommendations; }
  .case-body :global(.recommendations li::before) { position: absolute; left: -2.5em; color: var(--token-accent); font-family: var(--font-mono); content: counter(recommendations, decimal-leading-zero); }
  .case-body :global(.evidence-image + .evidence-image) { margin-top: 24px; }
  .case-body :global(.prose) { padding-top: 64px; color: var(--token-muted); font-size: 17px; line-height: 1.75; }
  .next-project { padding-top: 40px; padding-bottom: 72px; border-top: 1px solid var(--token-line); }
  .next-label, .next-category { margin: 0; color: var(--token-accent); font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; }
  .next-link { display: flex; min-height: 100px; align-items: center; justify-content: space-between; gap: 24px; color: var(--token-fg); text-decoration: none; }
  .next-link > span:first-child { display: grid; gap: 12px; }
  .next-title { font-size: clamp(32px, 5vw, 64px); font-weight: 500; letter-spacing: -0.03em; line-height: 1; transition: color var(--duration-base) var(--easing-standard); }
  .next-arrow { color: var(--token-accent); font-size: clamp(32px, 5vw, 64px); transition: transform var(--duration-base) var(--easing-standard); }
  .next-link:hover .next-title, .next-link:focus-visible .next-title { color: var(--token-accent); }
  .next-link:hover .next-arrow, .next-link:focus-visible .next-arrow { transform: translateX(4px); }
  @media (max-width: 767px) { .case-body :global(.case-section) { grid-template-columns: minmax(0, 1fr); gap: 20px; padding-top: 40px; } .case-body :global(.definition-list) { grid-template-columns: minmax(0, 1fr); } }
</style>

---
import { Image } from "astro:assets";
import type { Project } from "../../lib/projects";

interface Props { entry: Project }
const { entry } = Astro.props;
const order = String(entry.data.order).padStart(2, "0");
const category = entry.data.category === "security" ? "Security assessment" : "Web project";
const featuredImage = entry.data.featuredImage;
---

<a class="project-row" href={`/work/${entry.id}`}>
  <div class="project-copy">
    <p class="project-label">{order} — {category}</p>
    <h3 transition:name={`project-title-${entry.id}`}>{entry.data.title}</h3>
    <p class="description">{entry.data.shortDescription}</p>
    <ul class="technologies" aria-label="Technologies">
      {entry.data.technologies.map((technology) => <li>{technology}</li>)}
    </ul>
    <span class="case-study">View case study <span class="arrow">→</span></span>
  </div>
  <div class="media" aria-hidden="true" transition:name={`project-image-${entry.id}`}>
    <div class="media-bar"><i></i><i></i><i></i></div>
    {featuredImage ? (
      <Image src={featuredImage} alt="" width={featuredImage.width} height={featuredImage.height} loading="lazy" decoding="async" />
    ) : (
      <>
        <div class="media-texture"></div>
        <span class="media-placeholder">{order} / screenshot goes here</span>
      </>
    )}
    <span class="media-status">{entry.data.status}</span>
  </div>
</a>

<style>
  .project-row { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); align-items: center; gap: clamp(24px, 4vw, 64px); padding: 48px 0; border-top: 1px solid var(--token-line); background-color: transparent; color: inherit; text-decoration: none; transition: background-color var(--duration-fast) var(--easing-standard); }
  .project-label { margin: 0; color: var(--token-accent); font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; }
  h3 { margin: 18px 0 0; color: var(--token-fg); font-size: clamp(30px, 3.4vw, 48px); font-weight: 600; letter-spacing: -0.025em; line-height: 1.02; transition: color var(--duration-base) var(--easing-standard), transform var(--duration-base) var(--easing-standard); }
  .description { max-width: 440px; margin: 18px 0 0; color: var(--token-muted); font-size: 18px; line-height: 1.5; }
  .technologies { display: flex; flex-wrap: wrap; gap: 8px; margin: 24px 0 0; padding: 0; list-style: none; }
  .technologies li { padding: 5px 10px; border: 1px solid var(--token-line); border-radius: var(--radius-pill); color: var(--token-muted); font-family: var(--font-mono); font-size: 12px; }
  .case-study { display: inline-flex; align-items: center; gap: 8px; margin-top: 28px; color: var(--token-fg); font-family: var(--font-mono); font-size: 13px; transition: gap var(--duration-base) var(--easing-standard); }
  .arrow { color: var(--token-accent); transition: transform var(--duration-fast) var(--easing-standard); }
  .media { position: relative; aspect-ratio: 16 / 9; overflow: hidden; border: 1px solid var(--token-line); border-radius: var(--radius-media); background: var(--token-surface); transition: transform var(--duration-slow) var(--easing-standard), border-color var(--duration-slow) var(--easing-standard); }
  .media :global(img) { position: absolute; top: 34px; left: 0; width: 100%; height: calc(100% - 34px); object-fit: cover; object-position: top center; }
  .media-bar { position: absolute; z-index: 1; top: 0; right: 0; left: 0; display: flex; height: 34px; align-items: center; gap: 6px; padding-inline: 12px; border-bottom: 1px solid var(--token-line); }
  .media-bar i { width: 8px; height: 8px; border-radius: 50%; background: var(--token-line); }
  .media-texture { position: absolute; inset: 34px 0 0; background-image: linear-gradient(var(--token-grid) 1px, transparent 1px), linear-gradient(90deg, var(--token-grid) 1px, transparent 1px); background-size: 32px 32px; }
  .media-placeholder, .media-status { position: absolute; bottom: 16px; color: var(--token-muted); font-family: var(--font-mono); font-size: 12px; }
  .media-placeholder { left: 16px; }
  .media-status { right: 16px; color: var(--token-accent); }
  .project-row:hover, .project-row:focus-visible, .project-row:active { background-color: var(--token-surface); }
  .project-row:hover .media, .project-row:focus-visible .media, .project-row:active .media { transform: translateY(-6px); border-color: var(--token-accent); }
  .project-row:hover h3, .project-row:focus-visible h3, .project-row:active h3 { transform: translateX(4px); color: var(--token-accent); }
  .project-row:hover .case-study, .project-row:focus-visible .case-study, .project-row:active .case-study { gap: 14px; }
  .project-row:hover .arrow, .project-row:focus-visible .arrow, .project-row:active .arrow { transform: translateX(4px); }
  @media (max-width: 899px) { .project-row { grid-template-columns: minmax(0, 1fr); gap: 20px; } .media { order: -1; } }
</style>

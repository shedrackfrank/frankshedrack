---
import ProjectRow from "../project/ProjectRow.astro";
import { getProjects } from "../../lib/projects";

const projects = await getProjects();
const webCount = projects.filter((project) => project.data.category === "web").length;
const securityCount = projects.filter((project) => project.data.category === "security").length;
const count = (value: number) => String(value).padStart(2, "0");
---

<section id="work" class="wrap selected-work" aria-labelledby="work-heading">
  <div class="work-heading" data-reveal>
    <h2 id="work-heading">Selected work</h2>
    <p class="work-count">{count(projects.length)} projects · {count(webCount)} web · {count(securityCount)} security</p>
  </div>
  <ul class="project-list">
    {projects.map((entry, index) => <li data-reveal style={`--i: ${Math.min(index, 6)}`}><ProjectRow entry={entry} /></li>)}
  </ul>
</section>

<style>
  .selected-work { padding-block: 96px; }
  .work-heading { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 16px; margin-bottom: 56px; }
  h2 { margin: 0; color: var(--token-fg); font-size: clamp(34px, 4.6vw, 64px); font-weight: 600; letter-spacing: -0.03em; line-height: 1; }
  .work-count { margin: 0; color: var(--token-muted); font-family: var(--font-mono); font-size: 13px; }
  .project-list { margin: 0; padding: 0; list-style: none; }
</style>

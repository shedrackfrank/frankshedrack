---
import { skills } from "../../data/site";
---

<section id="skills" class="wrap section skills" aria-labelledby="skills-heading">
  <div class="skills-heading" data-reveal>
    <h2 id="skills-heading">Skills</h2>
    <p class="skills-note mono">What I reach for most</p>
  </div>
  <ul class="skill-list">
    {skills.map((skill, index) => (
      <li data-reveal style={`--i: ${Math.min(index, 6)}`}><span class="skill-name">{skill.name}</span><span class="skill-tag mono">{skill.tag}</span></li>
    ))}
  </ul>
</section>

<style>
  .section { padding-block: clamp(64px, 8vw, 96px); border-top: 1px solid var(--token-line); }
  .skills-heading { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 24px; margin-bottom: 48px; }
  h2 { margin: 0; color: var(--token-fg); font-size: clamp(34px, 4.6vw, 64px); font-weight: 600; letter-spacing: -0.03em; line-height: 1; }
  .skills-note { margin: 0; color: var(--token-muted); font-size: 13px; }
  .skill-list { margin: 0; padding: 0; border-bottom: 1px solid var(--token-line); list-style: none; }
  .skill-list li { display: flex; justify-content: space-between; align-items: baseline; gap: 24px; padding: 22px 0; border-top: 1px solid var(--token-line); color: var(--token-fg); transition: color var(--duration-slow) var(--easing-standard); }
  .skill-name { font-size: clamp(28px, 3.6vw, 48px); font-weight: 500; letter-spacing: -0.025em; line-height: 1; transition: transform var(--duration-slow) var(--easing-standard); }
  .skill-tag { color: var(--token-muted); font-size: 13px; text-align: right; }
  .skill-list li:hover, .skill-list li:active { color: var(--token-accent); }
  .skill-list li:hover .skill-name, .skill-list li:active .skill-name { transform: translateX(8px); }
  @media (max-width: 520px) { .skill-list li { align-items: flex-start; } .skill-tag { max-width: 45%; } }
</style>
